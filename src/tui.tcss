/* ============================================================
   GENEWEAVER
   GENOME PROCESSING DASHBOARD
   Bio-Tech Dark Interface
   ============================================================ */


/* ============================================================
   GLOBAL
   ============================================================ */

Screen {
    background: #061219;
    color: #d8f3f0;
}


/* ============================================================
   HEADER
   ============================================================ */

Header {
    background: #0a2028;
    color: #5eead4;
}


/* ============================================================
   FOOTER
   ============================================================ */

Footer {
    background: #0a2028;
    color: #8fb8b7;
}


/* ============================================================
   MAIN DASHBOARD
   ============================================================ */

#dashboard {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}


/* ============================================================
   HERO
   ============================================================ */

#hero {
    width: 100%;
    height: auto;
    padding: 1 2;
    margin-bottom: 1;
    background: #081c24;
    border: round #155e63;
}

#main-title {
    color: #5eead4;
    text-style: bold;
    width: 100%;
}

#main-subtitle {
    color: #e6fffc;
    text-style: bold;
    margin-top: 1;
}

#main-description {
    color: #759b9d;
    margin-top: 1;
}


/* ============================================================
   MAIN LAYOUT
   ============================================================ */

#main-layout {
    width: 100%;
    height: auto;
}


/* ============================================================
   SIDEBAR
   ============================================================ */

#sidebar {
    width: 32;
    min-width: 32;
    height: auto;
    padding-right: 1;
}


/* ============================================================
   CONTENT
   ============================================================ */

#content {
    width: 1fr;
    height: auto;
    padding-left: 1;
}


/* ============================================================
   CARDS
   ============================================================ */

.card {
    width: 100%;
    height: auto;
    background: #0b222b;
    border: round #145a60;
    padding: 1 2;
    margin-bottom: 1;
}


/* ============================================================
   CARD TITLES
   ============================================================ */

.card-title {
    color: #5eead4;
    text-style: bold;
    margin-bottom: 1;
}


/* ============================================================
   SETUP
   ============================================================ */

.setup-card {
    min-height: 20;
}


/* ============================================================
   FIELD LABELS
   ============================================================ */

.field-label {
    color: #71999b;
    text-style: bold;
    margin-top: 1;
}


/* ============================================================
   FIELD VALUES
   ============================================================ */

.field-value {
    color: #e4fbf8;
    text-style: bold;
}


/* ============================================================
   METRICS
   ============================================================ */

.metric-row {
    width: 100%;
    height: 2;
}

.metric-label {
    width: 1fr;
    color: #789b9d;
    text-style: bold;
}

.metric-value {
    width: auto;
    color: #e6fffc;
    text-style: bold;
}

.accent-value {
    width: auto;
    color: #5eead4;
    text-style: bold;
}


/* ============================================================
   PIPELINE STATUS
   ============================================================ */

.status-card {
    min-height: 9;
}

.status-badge {
    color: #5eead4;
    text-style: bold;
    border: round #1d7375;
    background: #0d3036;
    padding: 0 1;
    margin-bottom: 1;
}

.muted {
    color: #76999b;
}


/* ============================================================
   PROGRESS CARD
   ============================================================ */

.progress-card {
    min-height: 12;
}

.section-header {
    width: 100%;
    height: 2;
}

.percent {
    width: auto;
    color: #5eead4;
    text-style: bold;
}

.progress-info {
    width: 100%;
    height: 2;
    color: #9cc4c1;
}

#chunk_count {
    width: 1fr;
}

#current_file {
    width: auto;
}


/* ============================================================
   PROGRESS BARS
   ============================================================ */

ProgressBar {
    width: 100%;
    margin: 1 0;
}


/* ============================================================
   TWO COLUMN CARDS
   ============================================================ */

.two-column {
    width: 100%;
    height: auto;
}

.half-card {
    width: 1fr;
    margin-right: 1;
    min-height: 15;
}


/* ============================================================
   INFORMATION LINES
   ============================================================ */

.info-line {
    color: #b5d4d1;
    margin-bottom: 1;
}


/* ============================================================
   ALIGNMENT RESULT GRID
   ============================================================ */

.result-grid {
    width: 100%;
    height: 8;
}

.result-box {
    width: 1fr;
    height: 7;
    background: #0e2b34;
    border: round #174c52;
    padding: 1;
    margin-right: 1;
}

.result-label {
    color: #76999b;
    text-style: bold;
}

.result-number {
    color: #5eead4;
    text-style: bold;
    margin-top: 1;
}


/* ============================================================
   ALIGNMENT PROGRESS
   ============================================================ */

#alignment_progress {
    margin-top: 1;
}


/* ============================================================
   OFF-TARGET
   ============================================================ */

.ranking {
    color: #d9efec;
    margin-top: 1;
}


/* ============================================================
   DNA COMPARISON
   ============================================================ */

.dna-card {
    min-height: 16;
}

.sequence-label {
    color: #5eead4;
    text-style: bold;
    margin-top: 1;
}

.dna-sequence {
    width: 100%;
    background: #0e2d36;
    color: #d9efec;
    padding: 1;
    margin-top: 1;
}

.mismatch-line {
    color: #ff6666;
    text-style: bold;
    margin-top: 1;
}


/* ============================================================
   SCROLLBAR
   ============================================================ */

#dashboard {
    scrollbar-color: #145a60;
}